# ─── Decart ───────────────────────────────────────────────────────────
# Verified 2026-09-01: POST /v1/client/tokens returns 200 on this host.
API_BASE_URL=https://api.decart.ai
API_WS_BASE_URL=wss://api.decart.ai
API_VERSION=v1

# Realtime virtual try-on model.
DECART_REALTIME_MODEL=lucy-vton-latest

# Long-lived Decart API key.
#
# ONLY set this in development/staging. It can mint client tokens, so it must
# never ship in a release binary — an APK/IPA can be decompiled and the key
# extracted. Production leaves this blank and fetches a short-lived token from
# the backend instead (see TOKEN_ENDPOINT).
DECART_API_KEY=your-decart-api-key-here

# Backend that mints ephemeral client tokens (POST -> {apiKey, expiresAt}).
# Required in production, optional in development.
TOKEN_ENDPOINT=

ENABLE_LOGS=true
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
